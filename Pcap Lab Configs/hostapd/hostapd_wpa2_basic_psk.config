interface=wlx9cefd5f6950a
driver=nl80211
ssid=PCAP-Lab
hw_mode=a
channel=36
ieee80211n=1
wmm_enabled=1


# Beacon Interval
beacon_int=100

# Open network for simplest analysis (or add WPA2 below)
auth_algs=1
ignore_broadcast_ssid=0

# Optional WPA2-Personal for handshake capture
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=Testlab12345
